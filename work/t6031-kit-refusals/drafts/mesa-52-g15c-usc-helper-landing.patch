From 1e2cbea59d90d4c962c2373cc8f08d6c4b507e07 Mon Sep 17 00:00:00 2001
From: Naeem Malik <malik2015naeem@gmail.com>
Date: Sun, 18 Oct 2026 18:06:59 +0530
Subject: [PATCH] asahi: return every out-of-table USC helper call on G15C

On the M3 Max (G15C), half of each compute dispatch and of each draw ran
without its uniform state: compute-check got 4096 of 65536 words wrong,
and the vk and gl render checks got 2048 of 4096 pixels wrong. Without
kernel-side backing for it, the shader cores also faulted reading the
page after the USC window base page.

The profile prefix ends in a computed helper call. On G15C that call can
index past the base page's two ten-entry helper tables for some shader
cores, and the slots after the tables were zero, so the call did not
return. It ran on through the rest of the page and into the following
unmapped page, and the uniform state it was meant to load was skipped.

Fill every 16-byte slot from +0x2c0 to +0x340 and from +0x350 to the end
of the page with the helper table's terminal record, so any such call
returns inside the page. The zero block-size dword at +0x340 that ends
the page's container chain is left alone. Only G15C is changed; G15S and
every other chip build the same page as before.

Tested on J516C (M3 Max, 40 cores): compute-check, vk-render-check and
gl-render-check pass (0 wrong over ~2700-5700 runs each) with no
kernel-side page backing.

Assisted-by: Claude:claude-sonnet-5-5
Signed-off-by: Naeem Malik <malik2015naeem@gmail.com>
---
 src/asahi/lib/agx_device.c | 13 +++++++++++++
 src/asahi/lib/agx_linker.c | 25 +++++++++++++++++++------
 src/asahi/lib/agx_linker.h |  1 +
 3 files changed, 33 insertions(+), 6 deletions(-)

diff --git a/src/asahi/lib/agx_device.c b/src/asahi/lib/agx_device.c
index 316e2eb0717..4a725e2db3f 100644
--- a/src/asahi/lib/agx_device.c
+++ b/src/asahi/lib/agx_device.c
@@ -1488,6 +1488,19 @@ agx_open_device(void *memctx, struct agx_device *dev)
 
       memset(map, 0, usc_base_size);
       agx3_build_container_lead_for_chip(map, dev->chip);
+
+      /* On G15C the profile prefix's computed helper call can index past the
+       * two ten-entry helper tables for some shader cores (compare the
+       * ten-slot tables on G15S). Those calls would run on into the page
+       * after the base page, which is unmapped. Give every later slot a
+       * return so they stay inside this page. The dword at +0x340 is the
+       * zero block size that ends the page's container chain; leave it
+       * alone.
+       */
+      if (dev->chip == AGX_CHIP_G15C) {
+         agx3_fill_helper_terminals(map, 0x2c0, 0x340);
+         agx3_fill_helper_terminals(map, 0x350, usc_base_size);
+      }
       if (agx_bo_sync_for_device(usc_base, 0, usc_base_size))
          return false;
 
diff --git a/src/asahi/lib/agx_linker.c b/src/asahi/lib/agx_linker.c
index e3794717b96..8d2a7ac9b08 100644
--- a/src/asahi/lib/agx_linker.c
+++ b/src/asahi/lib/agx_linker.c
@@ -118,13 +118,15 @@ static const uint8_t sample_loop_footer[] = {
 #define AGX3_CONTAINER_CONST_PROG  0x40u
 
 /* "0f 00 54 <opcode> 00 x6 06 00 06 00 06 00" per record, then two terminals. */
+static const uint8_t agx3_helper_terminal[16] = {
+   0xf7, 0x03, 0xaa, 0x00, 0x8f, 0x02, 0x54, 0x01,
+   0x06, 0x00, 0x06, 0x00, 0x06, 0x00, 0x06, 0x00,
+};
+
 static void
 agx3_fill_helper_table(uint8_t *image, size_t base, unsigned positions)
 {
-   static const uint8_t terminal[16] = {
-      0xf7, 0x03, 0xaa, 0x00, 0x8f, 0x02, 0x54, 0x01,
-      0x06, 0x00, 0x06, 0x00, 0x06, 0x00, 0x06, 0x00,
-   };
+   const uint8_t *terminal = agx3_helper_terminal;
 
    for (unsigned i = 0; i < positions; ++i) {
       uint8_t *record = image + base + i * 0x10;
@@ -138,8 +140,8 @@ agx3_fill_helper_table(uint8_t *image, size_t base, unsigned positions)
          record[h + 1] = 0x00;
       }
    }
-   memcpy(image + base + positions * 16, terminal, sizeof(terminal));
-   memcpy(image + base + (positions + 1) * 16, terminal, sizeof(terminal));
+   memcpy(image + base + positions * 16, terminal, 16);
+   memcpy(image + base + (positions + 1) * 16, terminal, 16);
 }
 
 static void
@@ -181,6 +183,17 @@ agx3_build_container_lead_for_chip(uint8_t *image, enum agx_chip chip)
    agx3_fill_helper_table(image, 0x200, positions);
 }
 
+/* Put a helper terminal (a return) at every 16-byte slot in [from, to), so a
+ * helper call that lands on one of them returns instead of executing
+ * whatever the page happens to hold there.
+ */
+void
+agx3_fill_helper_terminals(uint8_t *image, size_t from, size_t to)
+{
+   for (size_t offset = from; offset + 16 <= to; offset += 16)
+      memcpy(image + offset, agx3_helper_terminal, 16);
+}
+
 void
 agx3_build_container_lead(uint8_t *image)
 {
diff --git a/src/asahi/lib/agx_linker.h b/src/asahi/lib/agx_linker.h
index ba6ff800b86..b5884ed993e 100644
--- a/src/asahi/lib/agx_linker.h
+++ b/src/asahi/lib/agx_linker.h
@@ -69,6 +69,7 @@ struct agx_linked_shader {
 #define AGX3_CONTAINER_LEAD_SIZE 0x340u
 void agx3_build_container_lead(uint8_t *image);
 void agx3_build_container_lead_for_chip(uint8_t *image, enum agx_chip chip);
+void agx3_fill_helper_terminals(uint8_t *image, size_t from, size_t to);
 
 enum agx_link_result {
    AGX_LINK_SUCCESS,
-- 
2.55.0

