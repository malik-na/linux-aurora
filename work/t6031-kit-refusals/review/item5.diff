+    fn publish(f: &mut Firmware, vm: &Arc<VmState>, render: bool) {
+        f.map_pb(vm).unwrap();
+        if render && f.recovery.reinit {
+            f.reset_ledger();
+            f.recovery.reinit = false;
+        }
+        f.engine.flights.push(Flight { job: Job { vm: vm.clone() } });
