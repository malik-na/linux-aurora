From f702ac4115bfe30c40b450832e5936e9386e5e76 Mon Sep 17 00:00:00 2001
From: Naeem Malik <malik2015naeem@gmail.com>
Date: Wed, 14 Oct 2026 06:07:22 +0530
Subject: [PATCH 1/2] asahi: G15C base page ends at its code entry too
 (experiment for malik-na/linux-aurora#50)

---
 src/asahi/lib/agx_device.c |  2 +-
 src/asahi/lib/agx_linker.c | 11 +++++++++++
 src/asahi/lib/agx_linker.h |  1 +
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/asahi/lib/agx_device.c b/src/asahi/lib/agx_device.c
index 1cf2182c5b0..ab171cd44f3 100644
--- a/src/asahi/lib/agx_device.c
+++ b/src/asahi/lib/agx_device.c
@@ -1491,7 +1491,7 @@ agx_open_device(void *memctx, struct agx_device *dev)
        * in the vertex/compute constant program, so a fetch from the window
        * base finds a terminated program rather than the bare lead block. */
       if (dev->chip == AGX_CHIP_G15C)
-         agx3_build_container(map, 0, false, dev->chip);
+         agx3_build_container_ending_at_entry(map, dev->chip);
       else
          agx3_build_container_lead_for_chip(map, dev->chip);
       if (agx_bo_sync_for_device(usc_base, 0, usc_base_size))
diff --git a/src/asahi/lib/agx_linker.c b/src/asahi/lib/agx_linker.c
index a9ce4024425..e83989a64e5 100644
--- a/src/asahi/lib/agx_linker.c
+++ b/src/asahi/lib/agx_linker.c
@@ -201,6 +201,17 @@ agx3_build_container(uint8_t *image, size_t code_size, bool fragment, enum agx_c
    agx3_build_container_constant_program(constant, fragment);
 }
 
+/* G15C experiment (malik-na/linux-aurora#50): a container whose code block is
+ * one more copy of its own constant program, so the code entry right after the
+ * constant program (lead + header + constant = +0x3c0) also ends. */
+void
+agx3_build_container_ending_at_entry(uint8_t *image, enum agx_chip chip)
+{
+   agx3_build_container(image, AGX3_CONTAINER_CONST_PROG, false, chip);
+   uint8_t *constant = image + AGX3_CONTAINER_LEAD + AGX3_CONTAINER_BLOCK_HDR;
+   memcpy(constant + AGX3_CONTAINER_CONST_PROG, constant, AGX3_CONTAINER_CONST_PROG);
+}
+
 static bool
 agx3_uses_code_container(const struct agx_device *dev)
 {
diff --git a/src/asahi/lib/agx_linker.h b/src/asahi/lib/agx_linker.h
index 0bf04911753..05995c3d70c 100644
--- a/src/asahi/lib/agx_linker.h
+++ b/src/asahi/lib/agx_linker.h
@@ -73,6 +73,7 @@ void agx3_build_container_lead_for_chip(uint8_t *image, enum agx_chip chip);
  * the CODE block's size word and its constant program. */
 void agx3_build_container(uint8_t *image, size_t code_size, bool fragment,
                           enum agx_chip chip);
+void agx3_build_container_ending_at_entry(uint8_t *image, enum agx_chip chip);
 
 enum agx_link_result {
    AGX_LINK_SUCCESS,
-- 
2.55.0


From 3a613ddaf3db8fefd434ab41e26d72abb83c3bf9 Mon Sep 17 00:00:00 2001
From: Naeem Malik <malik2015naeem@gmail.com>
Date: Wed, 14 Oct 2026 06:09:25 +0530
Subject: [PATCH 2/2] asahi: G15C base page also ends in its last 64 bytes
 (experiment for malik-na/linux-aurora#50)

---
 src/asahi/lib/agx_device.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/asahi/lib/agx_device.c b/src/asahi/lib/agx_device.c
index ab171cd44f3..55e1930f003 100644
--- a/src/asahi/lib/agx_device.c
+++ b/src/asahi/lib/agx_device.c
@@ -1490,9 +1490,13 @@ agx_open_device(void *memctx, struct agx_device *dev)
       /* G15C experiment: make the base page a complete container that ends
        * in the vertex/compute constant program, so a fetch from the window
        * base finds a terminated program rather than the bare lead block. */
-      if (dev->chip == AGX_CHIP_G15C)
+      if (dev->chip == AGX_CHIP_G15C) {
          agx3_build_container_ending_at_entry(map, dev->chip);
-      else
+         /* Also end the last 64 bytes of the page (+0x3fc0). They sit inside the range the
+          * asahi.t6031_usc_page kernel log prints, so the log shows this page reached the
+          * GPU, and a fetch anywhere in the page ends before the guard. */
+         memcpy(map + usc_base_size - 0x40, map + 0x380, 0x40);
+      } else
          agx3_build_container_lead_for_chip(map, dev->chip);
       if (agx_bo_sync_for_device(usc_base, 0, usc_base_size))
          return false;
-- 
2.55.0

