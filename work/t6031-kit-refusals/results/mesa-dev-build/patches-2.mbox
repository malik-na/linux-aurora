From caf2e155cd9f4f454d2f6c334950caf20dcb438e Mon Sep 17 00:00:00 2001
From: Naeem Malik <malik2015naeem@gmail.com>
Date: Wed, 14 Oct 2026 07:26:40 +0530
Subject: [PATCH] asahi: G15C launch experiment w3 (malik-na/linux-aurora#50)

---
 src/asahi/lib/agx3_compute_program_core.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/asahi/lib/agx3_compute_program_core.c b/src/asahi/lib/agx3_compute_program_core.c
index fa809cb6b34..0db1ddb7227 100644
--- a/src/asahi/lib/agx3_compute_program_core.c
+++ b/src/asahi/lib/agx3_compute_program_core.c
@@ -162,7 +162,10 @@ agx3_g17p_native_compute_launch_pack(
                                  (uint32_t)(program->program_va >> 32) << 16);
       agx3_cmdstream_store_le32(packed + 8,
                                  (uint32_t)(program->program_va >> 6));
-      agx3_cmdstream_store_le32(packed + 12, 0x40);
+      /* G15C experiment (malik-na/linux-aurora#50): the J516C driver sends the HAL200
+       * control word 0x40000000 here, not the T6030 layout's 0x40. */
+      agx3_cmdstream_store_le32(packed + 12,
+                                program->chip == AGX_CHIP_G15C ? UINT32_C(0x40000000) : 0x40);
       for (unsigned axis = 0; axis < 3; ++axis) {
          agx3_cmdstream_store_le32(packed + 16 + axis * 4, global_size[axis]);
          agx3_cmdstream_store_le32(packed + 28 + axis * 4, grid->local_size[axis]);
-- 
2.55.0

From 350923d3f3b640e2e8d2606f37d2c815c38460a8 Mon Sep 17 00:00:00 2001
