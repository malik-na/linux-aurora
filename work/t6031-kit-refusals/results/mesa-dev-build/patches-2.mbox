Subject: [PATCH] asahi: G15C launch experiment b23 (malik-na/linux-aurora#50)

---
 src/asahi/lib/agx3_compute_program_core.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/asahi/lib/agx3_compute_program_core.c b/src/asahi/lib/agx3_compute_program_core.c
index fa809cb6b34..9a55ba4ceb1 100644
--- a/src/asahi/lib/agx3_compute_program_core.c
+++ b/src/asahi/lib/agx3_compute_program_core.c
@@ -157,7 +157,9 @@ agx3_g17p_native_compute_launch_pack(
    if (agx_chip_uses_g15s_runtime(program->chip)) {
       if (program->launch_template.word1 != 0)
          return false;
-      agx3_cmdstream_store_le32(packed, program->launch_template.word0);
+      /* G15C experiment (malik-na/linux-aurora#50): the J516C driver sets word0 bit 23. */
+      agx3_cmdstream_store_le32(packed, program->launch_template.word0 |
+                                 (program->chip == AGX_CHIP_G15C ? UINT32_C(1) << 23 : 0));
       agx3_cmdstream_store_le32(packed + 4,
                                  (uint32_t)(program->program_va >> 32) << 16);
       agx3_cmdstream_store_le32(packed + 8,
-- 
