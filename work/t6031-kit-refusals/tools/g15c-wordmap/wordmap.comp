// g15c-wordmap kernel: invocation i writes wm_expect(i, steps) (analyze.c) to out[i] and its
// workgroup and local index to meta[i].
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { uint v[]; } out_buf;
layout(std430, binding = 1) buffer Meta { uint m[]; } meta_buf;
layout(push_constant) uniform Params { uint n; uint steps; } p;

void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i >= p.n)
      return;
   uint x = i * 2654435761u + 1u;
   for (uint k = 0u; k < p.steps; k++) {
      x ^= x << 13;
      x ^= x >> 17;
      x ^= x << 5;
      x += k;
   }
   out_buf.v[i] = x;
   meta_buf.m[i] = gl_WorkGroupID.x | (gl_LocalInvocationID.x << 16);
}
